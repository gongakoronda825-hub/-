[
 {
  "start": 0.0,
  "end": 2.566666666666667,
  "voice_start": 0.05,
  "voice_end": 2.444,
  "text": "ジブリ好きなのに、これ観てないのはもったいない！"
 },
 {
  "start": 2.566666666666667,
  "end": 5.6,
  "voice_start": 2.617,
  "voice_end": 5.487,
  "text": "マイナーだけど本当におすすめなジブリ映画、3選！"
 },
 {
  "start": 5.6,
  "end": 7.633333333333334,
  "voice_start": 5.9,
  "voice_end": 7.518,
  "text": "第3位、思い出のマーニー。"
 },
 {
  "start": 7.633333333333334,
  "end": 9.6,
  "voice_start": 7.683,
  "voice_end": 9.479,
  "text": "心を閉ざした少女、アンナが、"
 },
 {
  "start": 9.6,
  "end": 11.6,
  "voice_start": 9.65,
  "voice_end": 11.479,
  "text": "北海道の海辺の屋敷で出会った、"
 },
 {
  "start": 11.6,
  "end": 13.266666666666667,
  "voice_start": 11.65,
  "voice_end": 13.142,
  "text": "金髪の少女、マーニー。"
 },
 {
  "start": 13.266666666666667,
  "end": 15.933333333333334,
  "voice_start": 13.317,
  "voice_end": 15.826,
  "text": "二人の関係に隠された秘密がわかった瞬間、"
 },
 {
  "start": 15.933333333333334,
  "end": 17.433333333333334,
  "voice_start": 15.983,
  "voice_end": 17.305,
  "text": "涙が止まらなくなります。"
 },
 {
  "start": 17.433333333333334,
  "end": 19.433333333333334,
  "voice_start": 17.733,
  "voice_end": 19.311,
  "text": "第2位、コクリコ坂から。"
 },
 {
  "start": 19.433333333333334,
  "end": 21.933333333333334,
  "voice_start": 19.483,
  "voice_end": 21.815,
  "text": "舞台は1963年の横浜。"
 },
 {
  "start": 21.933333333333334,
  "end": 24.033333333333335,
  "voice_start": 21.983,
  "voice_end": 23.914,
  "text": "毎朝旗を揚げる少女、ウミと、"
 },
 {
  "start": 24.033333333333335,
  "end": 25.933333333333334,
  "voice_start": 24.083,
  "voice_end": 25.826,
  "text": "少年、シュンの甘酸っぱい恋。"
 },
 {
  "start": 25.933333333333334,
  "end": 28.266666666666666,
  "voice_start": 25.983,
  "voice_end": 28.163,
  "text": "古い部室棟、カルチェラタンの雰囲気と、"
 },
 {
  "start": 28.266666666666666,
  "end": 30.233333333333334,
  "voice_start": 28.317,
  "voice_end": 30.13,
  "text": "昭和レトロな街並みが最高です。"
 },
 {
  "start": 30.233333333333334,
  "end": 32.6,
  "voice_start": 30.533,
  "voice_end": 32.479,
  "text": "そして第1位は、海がきこえる。"
 },
 {
  "start": 32.6,
  "end": 35.53333333333333,
  "voice_start": 32.65,
  "voice_end": 35.403,
  "text": "実はテレビ用に作られた、知る人ぞ知る一本。"
 },
 {
  "start": 35.53333333333333,
  "end": 37.36666666666667,
  "voice_start": 35.583,
  "voice_end": 37.231,
  "text": "高知の高校生、タクと、"
 },
 {
  "start": 37.36666666666667,
  "end": 41.8,
  "voice_start": 37.417,
  "voice_end": 41.673,
  "text": "東京から来た転校生、リカコ。わがままなのに目が離せない彼女との、"
 },
 {
  "start": 41.8,
  "end": 43.4,
  "voice_start": 41.85,
  "voice_end": 43.278,
  "text": "リアルな青春が刺さります。"
 },
 {
  "start": 43.4,
  "end": 47.53333333333333,
  "voice_start": 43.45,
  "voice_end": 46.34,
  "text": "あなたはどれを観たことある？コメントで教えてね！"
 }
]