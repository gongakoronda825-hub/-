[
 {
  "start": 0.0,
  "end": 3.033333333333333,
  "voice_start": 0.05,
  "voice_end": 2.92,
  "text": "マイナーだけど本当におすすめなジブリ映画、3選！"
 },
 {
  "start": 3.033333333333333,
  "end": 5.066666666666666,
  "voice_start": 3.333,
  "voice_end": 4.951,
  "text": "第3位、思い出のマーニー。"
 },
 {
  "start": 5.066666666666666,
  "end": 7.033333333333333,
  "voice_start": 5.117,
  "voice_end": 6.912,
  "text": "心を閉ざした少女、アンナが、"
 },
 {
  "start": 7.033333333333333,
  "end": 9.033333333333333,
  "voice_start": 7.083,
  "voice_end": 8.912,
  "text": "北海道の海辺の屋敷で出会った、"
 },
 {
  "start": 9.033333333333333,
  "end": 10.7,
  "voice_start": 9.083,
  "voice_end": 10.575,
  "text": "金髪の少女、マーニー。"
 },
 {
  "start": 10.7,
  "end": 13.366666666666667,
  "voice_start": 10.75,
  "voice_end": 13.26,
  "text": "二人の関係に隠された秘密がわかった瞬間、"
 },
 {
  "start": 13.366666666666667,
  "end": 14.866666666666667,
  "voice_start": 13.417,
  "voice_end": 14.739,
  "text": "涙が止まらなくなります。"
 },
 {
  "start": 14.866666666666667,
  "end": 16.866666666666667,
  "voice_start": 15.167,
  "voice_end": 16.745,
  "text": "第2位、コクリコ坂から。"
 },
 {
  "start": 16.866666666666667,
  "end": 19.366666666666667,
  "voice_start": 16.917,
  "voice_end": 19.248,
  "text": "舞台は1963年の横浜。"
 },
 {
  "start": 19.366666666666667,
  "end": 21.466666666666665,
  "voice_start": 19.417,
  "voice_end": 21.347,
  "text": "毎朝旗を揚げる少女、ウミと、"
 },
 {
  "start": 21.466666666666665,
  "end": 23.366666666666667,
  "voice_start": 21.517,
  "voice_end": 23.26,
  "text": "少年、シュンの甘酸っぱい恋。"
 },
 {
  "start": 23.366666666666667,
  "end": 25.7,
  "voice_start": 23.417,
  "voice_end": 25.596,
  "text": "古い部室棟、カルチェラタンの雰囲気と、"
 },
 {
  "start": 25.7,
  "end": 27.666666666666668,
  "voice_start": 25.75,
  "voice_end": 27.563,
  "text": "昭和レトロな街並みが最高です。"
 },
 {
  "start": 27.666666666666668,
  "end": 30.033333333333335,
  "voice_start": 27.967,
  "voice_end": 29.912,
  "text": "そして第1位は、海がきこえる。"
 },
 {
  "start": 30.033333333333335,
  "end": 32.96666666666667,
  "voice_start": 30.083,
  "voice_end": 32.836,
  "text": "実はテレビ用に作られた、知る人ぞ知る一本。"
 },
 {
  "start": 32.96666666666667,
  "end": 34.8,
  "voice_start": 33.017,
  "voice_end": 34.664,
  "text": "高知の高校生、タクと、"
 },
 {
  "start": 34.8,
  "end": 39.233333333333334,
  "voice_start": 34.85,
  "voice_end": 39.107,
  "text": "東京から来た転校生、リカコ。わがままなのに目が離せない彼女との、"
 },
 {
  "start": 39.233333333333334,
  "end": 40.833333333333336,
  "voice_start": 39.283,
  "voice_end": 40.711,
  "text": "リアルな青春が刺さります。"
 },
 {
  "start": 40.833333333333336,
  "end": 44.96666666666667,
  "voice_start": 40.883,
  "voice_end": 43.774,
  "text": "あなたはどれを観たことある？コメントで教えてね！"
 }
]