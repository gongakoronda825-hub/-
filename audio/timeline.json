[
 {
  "start": 0.0,
  "end": 2.5,
  "voice_start": 0.05,
  "voice_end": 2.375,
  "text": "ジブリ好きなのに、これ観てないのはもったいない！"
 },
 {
  "start": 2.5,
  "end": 5.5,
  "voice_start": 2.55,
  "voice_end": 5.378,
  "text": "マイナーだけど本当におすすめなジブリ映画、3選！"
 },
 {
  "start": 5.5,
  "end": 7.533333333333333,
  "voice_start": 5.8,
  "voice_end": 7.407,
  "text": "第3位、思い出のマーニー。"
 },
 {
  "start": 7.533333333333333,
  "end": 9.466666666666667,
  "voice_start": 7.583,
  "voice_end": 9.336,
  "text": "心を閉ざした少女、アンナが、"
 },
 {
  "start": 9.466666666666667,
  "end": 11.433333333333334,
  "voice_start": 9.517,
  "voice_end": 11.314,
  "text": "北海道の海辺の屋敷で出会った、"
 },
 {
  "start": 11.433333333333334,
  "end": 13.066666666666666,
  "voice_start": 11.483,
  "voice_end": 12.953,
  "text": "金髪の少女、マーニー。"
 },
 {
  "start": 13.066666666666666,
  "end": 15.666666666666666,
  "voice_start": 13.117,
  "voice_end": 15.541,
  "text": "二人の関係に隠された秘密がわかった瞬間、"
 },
 {
  "start": 15.666666666666666,
  "end": 17.133333333333333,
  "voice_start": 15.717,
  "voice_end": 17.015,
  "text": "涙が止まらなくなります。"
 },
 {
  "start": 17.133333333333333,
  "end": 19.1,
  "voice_start": 17.433,
  "voice_end": 18.979,
  "text": "第2位、コクリコ坂から。"
 },
 {
  "start": 19.1,
  "end": 21.566666666666666,
  "voice_start": 19.15,
  "voice_end": 21.463,
  "text": "舞台は1963年の横浜。"
 },
 {
  "start": 21.566666666666666,
  "end": 23.633333333333333,
  "voice_start": 21.617,
  "voice_end": 23.526,
  "text": "毎朝旗を揚げる少女、ウミと、"
 },
 {
  "start": 23.633333333333333,
  "end": 25.533333333333335,
  "voice_start": 23.683,
  "voice_end": 25.416,
  "text": "少年、シュンの甘酸っぱい恋。"
 },
 {
  "start": 25.533333333333335,
  "end": 27.833333333333332,
  "voice_start": 25.583,
  "voice_end": 27.7,
  "text": "古い部室棟、カルチェラタンの雰囲気と、"
 },
 {
  "start": 27.833333333333332,
  "end": 29.8,
  "voice_start": 27.883,
  "voice_end": 29.675,
  "text": "昭和レトロな街並みが最高です。"
 },
 {
  "start": 29.8,
  "end": 32.13333333333333,
  "voice_start": 30.1,
  "voice_end": 32.005,
  "text": "そして第1位は、海がきこえる。"
 },
 {
  "start": 32.13333333333333,
  "end": 34.93333333333333,
  "voice_start": 32.183,
  "voice_end": 34.809,
  "text": "実はテレビ用に作られた、知る人ぞ知る一本。"
 },
 {
  "start": 34.93333333333333,
  "end": 36.766666666666666,
  "voice_start": 34.983,
  "voice_end": 36.631,
  "text": "高知の高校生、タクと、"
 },
 {
  "start": 36.766666666666666,
  "end": 41.13333333333333,
  "voice_start": 36.817,
  "voice_end": 41.02,
  "text": "東京から来た転校生、リカコ。わがままなのに目が離せない彼女との、"
 },
 {
  "start": 41.13333333333333,
  "end": 42.666666666666664,
  "voice_start": 41.183,
  "voice_end": 42.547,
  "text": "リアルな青春が刺さります。"
 },
 {
  "start": 42.666666666666664,
  "end": 46.5,
  "voice_start": 42.717,
  "voice_end": 45.309,
  "text": "あなたはどれを観たことある？コメントで教えてね！"
 }
]