# サーバーレス関数（/api）が使う環境変数。
# クライアント（ブラウザ）には一切渡さない。ホスティング先のプロジェクト設定に登録すること。
# VITE_ プレフィックスは絶対に付けないこと（付けるとバンドルに埋め込まれて露出する）。

# eBay Browse API（出品中の相場・競合数）
# https://developer.ebay.com/ でアプリ登録して取得
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=production

# 楽天市場 商品検索API
# https://webservice.rakuten.co.jp/
RAKUTEN_APP_ID=
RAKUTEN_AFFILIATE_ID=

# Yahoo!ショッピング 商品検索API
# https://developer.yahoo.co.jp/
YAHOO_APP_ID=

# 為替（未設定なら https://open.er-api.com/v6/latest/USD をキー無しで使う）
FX_API_URL=
